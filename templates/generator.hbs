{{#if error}}
  <p class="notification error">{{error}}</p>
{{else}}
  <div class="onomasticon-generator">
    <div class="form-group">
      <label for="onomasticon-pack">{{localize "ONOMASTICON.GeneratorApp.PackLabel"}}</label>
      <select id="onomasticon-pack" name="packId">
        {{#each packGroups}}
          <optgroup label="{{tag}}">
            {{#each packs}}
              <option value="{{id}}" {{selectedAttr}}>{{label}}</option>
            {{/each}}
          </optgroup>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label for="onomasticon-variant">{{localize "ONOMASTICON.GeneratorApp.VariantLabel"}}</label>
      <input
        id="onomasticon-variant"
        type="text"
        name="variant"
        placeholder="{{localize 'ONOMASTICON.GeneratorApp.VariantPlaceholder'}}"
        value="{{variant}}"
      />
    </div>

    <button type="button" data-action="generate">
      <i class="fa-solid fa-dice"></i>
      {{localize "ONOMASTICON.GeneratorApp.Generate"}}
    </button>

    <hr />

    <div class="form-group onomasticon-kin-count">
      <label for="onomasticon-kin-count">{{localize
          "ONOMASTICON.GeneratorApp.KinCountLabel"
        }}</label>
      <input
        id="onomasticon-kin-count"
        type="number"
        name="kinCount"
        min="1"
        value="{{kinCount}}"
      />
      <button
        type="button"
        data-action="setKinRows"
        title="{{localize 'ONOMASTICON.GeneratorApp.KinSetCountTitle'}}"
      >
        {{localize "ONOMASTICON.GeneratorApp.KinSetCount"}}
      </button>
    </div>

    <div class="onomasticon-kin-rows">
      {{#each kinRows}}
        <div class="form-group">
          <label for="onomasticon-kin-variant-{{this.index}}">
            {{localize "ONOMASTICON.GeneratorApp.KinMemberLabel" number=this.index}}
          </label>
          <input
            id="onomasticon-kin-variant-{{this.index}}"
            type="text"
            class="onomasticon-kin-variant"
            placeholder="{{localize 'ONOMASTICON.GeneratorApp.VariantPlaceholder'}}"
            value="{{this.variant}}"
          />
        </div>
      {{/each}}
    </div>

    <button type="button" data-action="generateKin">
      <i class="fa-solid fa-people-group"></i>
      {{localize "ONOMASTICON.GeneratorApp.KinGenerate"}}
    </button>

    {{#if showClearAll}}
      <button type="button" class="onomasticon-clear-all" data-action="clearResults">
        <i class="fa-solid fa-trash"></i>
        {{localize "ONOMASTICON.GeneratorApp.ClearAll"}}
      </button>
    {{/if}}

    <div class="form-group onomasticon-journal-controls">
      <select
        name="journalTarget"
        title="{{localize 'ONOMASTICON.GeneratorApp.JournalTargetTitle'}}"
      >
        <option value="">{{localize "ONOMASTICON.GeneratorApp.JournalCreateNew"}}</option>
        {{#each journalEntries}}
          <option value="{{this.id}}">{{this.name}}</option>
        {{/each}}
      </select>
      <button type="button" data-action="sendToJournal">
        <i class="fa-solid fa-book"></i>
        {{localize "ONOMASTICON.GeneratorApp.SendToJournal"}}
      </button>
    </div>

    <ol class="onomasticon-results">
      {{#each results}}
        <li>
          <span class="index">{{this.index}}.</span>
          <span class="full-name">{{this.full}}</span>
          <button
            type="button"
            data-action="copy"
            data-full="{{this.full}}"
            title="{{localize 'ONOMASTICON.GeneratorApp.CopyTitle'}}"
          >
            <i class="fa-solid fa-copy"></i>
          </button>
          <button
            type="button"
            data-action="applyToActor"
            data-index="{{this.index}}"
            title="{{localize 'ONOMASTICON.GeneratorApp.ApplyTitle'}}"
          >
            <i class="fa-solid fa-user-check"></i>
          </button>
          <button
            type="button"
            data-action="deleteResult"
            data-index="{{this.index}}"
            title="{{localize 'ONOMASTICON.GeneratorApp.DeleteTitle'}}"
          >
            <i class="fa-solid fa-trash"></i>
          </button>
        </li>
      {{/each}}
    </ol>
  </div>
{{/if}}