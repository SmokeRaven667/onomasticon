{{#if error}}
  <p class="notification error">{{error}}</p>
{{else}}
  <div class="onomasticon-generator">
    <div class="form-group">
      <label for="onomasticon-pack">Pack</label>
      <select id="onomasticon-pack" name="packId">
        {{#each packGroups}}
          <optgroup label="{{tag}}">
            {{#each packs}}
              <option value="{{id}}" {{selectedAttr}}>{{label}}</option>
            {{/each}}
          </optgroup>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label for="onomasticon-variant">Variant</label>
      <input
        id="onomasticon-variant"
        type="text"
        name="variant"
        placeholder="masc, fem, neutral..."
        value="{{variant}}"
      />
    </div>

    <button type="button" data-action="generate">
      <i class="fa-solid fa-dice"></i>
      Generate
    </button>

    <ol class="onomasticon-results">
      {{#each results}}
        <li>
          <span class="index">{{this.index}}.</span>
          <span class="full-name">{{this.full}}</span>
          <button
            type="button"
            data-action="copy"
            data-full="{{this.full}}"
            title="Copy to clipboard"
          >
            <i class="fa-solid fa-copy"></i>
          </button>
        </li>
      {{/each}}
    </ol>
  </div>
{{/if}}